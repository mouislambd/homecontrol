# Exact allowed frontend origins, comma-separated. Add the precise Vercel
# preview URL from the browser here when testing a preview deployment.
FRONTEND_ORIGIN=http://localhost:5173
# BACKEND_CORS_ORIGINS=https://homecontrol-app.vercel.app,https://<preview>.vercel.app

# Optional: logging verbosity (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# Optional: enable SQLite persistence instead of in-memory storage
# SMART_HOME_DB_PATH=./smart-home.db

# PostgreSQL connection. Set this in your local environment/hosting dashboard.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/smart-home-db

# Optional: isolated database used only by the test suite.
# TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/smart-home-db_test

# Optional: when set to production, localhost CORS origins are not allowed.
# APP_ENV=production

# Optional: insert the demo user/rooms/devices once (explicit opt-in only).
# SEED_DEMO_DATA=true
